<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:UserControls="clr-namespace:QA_Master.Forms.UserControls"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:forms="clr-namespace:QA_Master.Forms" d:DataContext="{d:DesignInstance Type=forms:Session}"
    x:Class="QA_Master.Forms.MainWindow"
    mc:Ignorable="d"
    Title="{Binding Path=WindowTitle, UpdateSourceTrigger=PropertyChanged}"
    Closing="Window_Closing"
    Height="720"
    MinHeight="720"
    Width="1200"
    MinWidth="1200"
    WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5.5*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="4.5*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5*" />
                    <RowDefinition Height="5*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5*" />
                            <RowDefinition Height="5*" />
                        </Grid.RowDefinitions>
                        <GroupBox Name="grpProject" Header="Project Name" Grid.Row="0">
                            <TextBox
                                Name="txtProject"
                                Text="{Binding Path=Project.Name, UpdateSourceTrigger=PropertyChanged}"
                                Height="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize*2}">
                            </TextBox>
                        </GroupBox>
                        <GroupBox Header="Base URLs" Grid.Row="1">
                            <TextBox
                                Name="txtBaseUrls"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                Text="{Binding Path=Project.BaseURLs}"
                                Height="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize*6}"
                                VerticalScrollBarVisibility="Visible">
                            </TextBox>
                        </GroupBox>
                    </Grid>
                    <GroupBox  Grid.Column="1" Grid.RowSpan="2" Header="File">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="5*" />
                                <RowDefinition Height="5*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" VerticalAlignment="Top">
                                <Button Name="btnNewProject" Content="New..." Click="btnNewProject_Click"></Button>
                                <Button Name="btnOpenProject" Content="Open..." Click="btnOpenProject_Click"></Button>
                            </StackPanel>
                            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                                <Button Name="btnSaveProject" Content="Save(...)" Click="btnSaveProject_Click"></Button>
                                <Button Name="btnSaveProjectAs" Content="Save As..." Click="btnSaveProjectAs_Click"></Button>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>

                <UserControls:AdvancedListControl
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    x:Name="alcWorkflow"
                    Title="Workflows"
                    HideRunButton="True"
                    ButtonClick="alcWorkflow_ButtonClick"
                    SelectedItemChanged="alcWorkflow_SelectedItemChanged"
                    />
                
                <UserControls:AdvancedListControl
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    x:Name="alcAction"
                    Title="Actions"
                    RunButtonTooltip="Test..."
                    ButtonClick="alcAction_ButtonClick"
                    SelectedItemChanged="alcAction_SelectedItemChanged"
                    />
            </Grid>
            <Rectangle
                Grid.Column="1"
                Fill="{DynamicResource {x:Static SystemColors.WindowFrameBrushKey}}"
                Width="1px"
                Margin="6">
            </Rectangle>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="6*" />
                </Grid.RowDefinitions>
                <UserControls:AdvancedListControl
                    Grid.Row="0"
                    x:Name="alcTestCase"
                    Title="Test Case"
                    ButtonClick="alcTestCase_ButtonClick"
                    SelectedItemChanged="alcTestCase_SelectedItemChanged"
                    />
                <UserControls:AdvancedListControl
                    Grid.Row="3"
                    x:Name="alcTestCaseWorkflow"
                    Title="Workflow"
                    HideEditButton="False"
                    HideAddSimilarButton="False"
                    HideRunButton="True"
                    ButtonClick="alcTestCaseWorkflow_ButtonClick"
                    />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
