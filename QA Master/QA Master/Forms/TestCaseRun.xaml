<Window x:Class="QA_Master.Forms.TestCaseRun"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QA_Master.Forms"
        xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
        xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:local2="clr-namespace:QA_Master.Models.Core"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Title="Test Case Runner"
        Height="640"
        Width="900"
        MinHeight="640"
        MinWidth="900"
        Closing="Window_Closing">
    <Window.Resources>
        <local:StatusVisibilityConverter x:Key="statusVisibilityConverter" />
        <local:PassFailColorBrushConverter x:Key="passFailColorBrushConverter" />
    </Window.Resources>
    <DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="35*" />
                <ColumnDefinition Width="65*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Select Browser :" />
            <ComboBox Grid.Row="0" Grid.Column="1" Name="cmbBrowser" />

            <Label Grid.Row="1" Grid.Column="0" Content="Select URL :" />
            <ComboBox Grid.Row="1" Grid.Column="1" Name="cmbBaseURL" />

            <Label Grid.Row="2" Grid.Column="0" Content="Workflows to Run :" HorizontalAlignment="Left" />
            <ProgressBar Grid.Row="2" Grid.Column="1" Name="pBar" Height="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize/8}" />

            <ListBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Name="lstWorkflows" SelectionChanged="lstWorkflows_SelectionChanged" >
                <ListBox.Resources>
                    <Style TargetType="StackPanel">
                        <Setter Property="Margin" Value="0" />
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="local2:TestCaseWorkflow">
                        <StackPanel Orientation="Horizontal" >
                            <TextBlock Text="{Binding}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Converter={StaticResource statusVisibilityConverter}, Path=RunStatus}">
                                <TextBlock Text=" ► [" />
                                <TextBlock Text="{Binding Path=GetRunStatus}" Foreground="{Binding Converter={StaticResource passFailColorBrushConverter}, Path=RunStatus}" />
                                <TextBlock Text="]"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Label Grid.Row="4" Grid.Column="0" Content="Actions to Run :" HorizontalAlignment="Left" />
            <CheckBox Grid.Row="4" Grid.Column="1" Content="Run all Action(s)" Name="chkRunAllAction" />

            <ListBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Name="lstActions" SelectionChanged="lstActions_SelectionChanged" >
                <ListBox.Resources>
                    <Style TargetType="StackPanel">
                        <Setter Property="Margin" Value="0" />
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="local2:Action">
                        <StackPanel Orientation="Horizontal" >
                            <TextBlock Text="{Binding}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Converter={StaticResource statusVisibilityConverter}, Path=RunStatus}">
                                <TextBlock Text=" ► [Action : " />
                                <TextBlock Text="{Binding GetRunStatus}" Foreground="{Binding Converter={StaticResource passFailColorBrushConverter}, Path=RunStatus}" />
                                <StackPanel Orientation="Horizontal" Visibility="{Binding Converter={StaticResource statusVisibilityConverter}, Path=Perform}">
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding Converter={StaticResource statusVisibilityConverter}, Path=Perform.RunStatus}">
                                        <TextBlock Text=", Perform : " />
                                        <TextBlock Text="{Binding Perform.GetRunStatus}" Foreground="{Binding Converter={StaticResource passFailColorBrushConverter}, Path=Perform.RunStatus}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="]"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal">
                <Button Name="btnRun" Content="Run" Click="btnRun_Click" />
                <Button Name="btnGenerateReport" Content="Generate Report..." Click="btnGenerateReport_Click" Width="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize*10}" />
            </StackPanel>

            <Button Grid.Row="6" Grid.Column="1" Name="btnClose" Content="Close" HorizontalAlignment="Right" Click="btnClose_Click" />
        </Grid>
    </DockPanel>
</Window>
