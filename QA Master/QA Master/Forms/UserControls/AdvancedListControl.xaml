<UserControl x:Class="QA_Master.Forms.UserControls.AdvancedListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:usercontrols="clr-namespace:QA_Master.Forms.UserControls"
             d:DataContext="{d:DesignInstance Type=usercontrols:AdvancedListControl}"
             xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="450"
             BorderThickness="0px"
             MinWidth="300"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             >
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize*2}" />
            <Setter Property="Width" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize*2}" />
            <Setter Property="Margin" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize/9}" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Margin" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize/3}" />
        </Style>
        <Style TargetType="Image">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <GroupBox
        Name="grpBox"
        Header="{Binding Title}"        
        Margin="0"
        Padding="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ListBox
                Name="lstBox"
                Grid.Column="0"
                ItemsSource="{Binding ListCollection}"
                SelectedItem="{Binding Path=SelectedItem}"
                MouseDoubleClick="lstBox_MouseDoubleClick"
                SelectionChanged="lstBox_SelectionChanged">
            </ListBox>
            
            <Grid Grid.Column="1" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="1*"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>


                <StackPanel>
                    <Separator Grid.Row="0" Grid.ColumnSpan="2" Margin="{c:Binding ElementName=grpBox, Path=FontSize/9}" Height="0" />

                    <Button Grid.Row="1" Grid.Column="0" Name="btnAdd" ToolTip="Add..." Click="btnAdd_Click" IsEnabled="False">
                    <Image Source="/Forms/Images/Add.png" />
                    </Button>
                    <Button Grid.Row="1" Grid.Column="1" Name="btnAddSimilar" ToolTip="Add Similar..." IsEnabled="False" Click="btnAddSimilar_Click">
                        <Image Source="/Forms/Images/Clone.png" />
                    </Button>

                    <Button Grid.Row="2" Grid.Column="0" Name="btnUp" ToolTip="Move Up" IsEnabled="False" Click="btnUp_Click">
                        <Image Source="/Forms/Images/Up.png" />
                    </Button>
                    <Button Grid.Row="2" Grid.Column="1" Name="btnDown" ToolTip="Move Down" IsEnabled="False" Click="btnDown_Click">
                        <Image Source="/Forms/Images/Down.png" />
                    </Button>

                    <Button Grid.Row="3" Grid.Column="0" Name="btnRun" ToolTip="Run..." IsEnabled="False" Click="btnRun_Click">
                        <Image Source="/Forms/Images/Run.png" />
                    </Button>

                    <Button Grid.Row="4" Grid.Column="0" Name="btnEdit" ToolTip="Edit..." IsEnabled="False" Click="btnEdit_Click">
                        <Image Source="/Forms/Images/Edit.png" />
                    </Button>
                    <Button Grid.Row="4" Grid.Column="1" Name="btnDelete" ToolTip="Delete..." IsEnabled="False" Click="btnDelete_Click" VerticalAlignment="Bottom">
                        <Image Source="/Forms/Images/Delete.png" />
                    </Button>

                </StackPanel>
            
            </Grid>
        </Grid>
    </GroupBox>
</UserControl>
