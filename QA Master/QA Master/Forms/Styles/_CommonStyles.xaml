<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
                    xmlns:sys1="http://schemas.microsoft.com/netfx/2009/xaml/presentation"
                    xmlns:sys2="clr-namespace:System;assembly=netstandard">

    <sys1:FontFamily x:Key="FontFamily">Segoe UI</sys1:FontFamily>
    <sys2:Double x:Key="FontSize">12.0</sys2:Double>

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize}" />
        <Setter Property="Padding" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize*2}" />
    </Style>
    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize}" />
    </Style>
    <Style TargetType="Page">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Margin" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize/3}" />
        <Setter Property="Padding" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize/4}" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="Height" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize*2}" />
        <Setter Property="Width" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize*6.78}" />
        <Setter Property="Margin" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize/3}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize/3}" />
        <Setter Property="Padding" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize/4}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize/3}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize/4}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MinWidth" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize*20}" />
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Margin" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize/3}" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize/3}" />
        <Setter Property="Padding" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize/4}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Margin" Value="{c:Binding RelativeSource={RelativeSource Self}, Path=FontSize/3}" />
    </Style>
    <Style TargetType="DockPanel">
        <Setter Property="Margin" Value="{c:Binding RelativeSource= {RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=FontSize}" />
    </Style>
</ResourceDictionary>