<Page x:Class="QA_Master.Forms.Pages.Page_ActionFindHtmlElement"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:core="clr-namespace:QA_Master.Models.Core"
      xmlns:System="clr-namespace:System;assembly=mscorlib"
      xmlns:enums="clr-namespace:QA_Master.Models.Enums"
      xmlns:local="clr-namespace:QA_Master.Forms"
      d:DataContext="{d:DesignInstance Type=core:ActionFindHtmlElement}"
      mc:Ignorable="d" 
      Height="Auto"
      d:DesignWidth="500"
      Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
      Title="ActionFindElement">
    <Page.Resources>
        <local:EnumDescriptionConverter x:Key="enumDescriptionConverter" />
        <ObjectDataProvider x:Key="dataFromEnum" MethodName="GetValues" ObjectType="{x:Type System:Enum}" >
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:EnumActionFindHtmlElementBy" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="7*" />
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Find HTML Element By :" />
        <ComboBox
            Grid.Row="0"
            Grid.Column="1"
            Name="cmbFindBy"
            SelectedItem="{Binding Path=EnumActionFindHtmlElementBy}"
            ItemsSource="{Binding Source={StaticResource dataFromEnum}}" >
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource enumDescriptionConverter}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Label Grid.Row="1" Grid.Column="0" Content="Value :" Name="lblValue" />
        <TextBox Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Name="txtValue" Text="{Binding Path=FindHtmlElementValue}" d:Text="Sample Data"  Padding="0,5,0,0" />

        <Label Grid.Row="3" Grid.Column="0" Content="Perform :" />
        <ComboBox Grid.Row="3" Grid.Column="1" Name="cmbPerform"
                  SelectedItem="{Binding GetPerformClassesItem}"
                  ItemsSource="{Binding GetPerformClasses}"
                  SelectionChanged="cmbPerform_SelectionChanged" />

        <Frame Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Name="frmPerform" NavigationUIVisibility="Hidden" Height="Auto" MinHeight="10" />

    </Grid>
</Page>
