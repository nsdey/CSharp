<Window x:Class="QA_Master.Forms.TestCaseAddWorkFlow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QA_Master.Forms" xmlns:core="clr-namespace:QA_Master.Models.Core"
        d:DataContext="{d:DesignInstance Type=core:Project}"
        mc:Ignorable="d"
        Title="Add WorkFlow(s)"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Height="540"
        Width="480">
    <DockPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="Workflows:" HorizontalAlignment="Left" />

            <ListBox Grid.Row="1" Name="lstWorkflow" SelectionMode="Multiple" ItemsSource="{Binding Workflows}">
                <!--<ListBox.ItemTemplate>
                    <DataTemplate>
                        <ListBoxItem IsSelected="{Binding IsChecked}" Padding="1">
                            <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Path=Item}" Padding="0" Margin="0" />
                        </ListBoxItem>
                    </DataTemplate>
                </ListBox.ItemTemplate>-->
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Add" Name="btnAdd" Click="btnAdd_Click" />
                <Button Content="Close" Name="btnClose" Click="btnClose_Click" />
            </StackPanel>
            
        </Grid>
    </DockPanel>
</Window>
