<Window x:Class="Go8_SQL_Deployment.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Go8_SQL_Deployment"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="800" Width="850">
    <Window.Resources>
        <local:NullVisibility x:Key="nullVisibility" />
        <local:RunStatusVisibility x:Key="runStatusVisibility" />
        <local:RunStatusRunningVisibility x:Key="runStatusRunningVisibility" />
        <local:RunStatusSuccessVisibility x:Key="runStatusSuccessVisibility" />
        <local:RunStatusFailedVisibility x:Key="runStatusFailedVisibility" />
        <Style TargetType="Button">
            <Setter Property="Height" Value="36" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            
            <TreeView Name="tvSQLFiles" d:DataContext="local:CommonClass" SelectedItemChanged="tvSQLFiles_SelectedItemChanged">
                <TreeView.Resources>
                    <LinearGradientBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" EndPoint="0,1" StartPoint="0,0">
                        <GradientStop Color="#FFD9F4FF" Offset="0"/>
                        <GradientStop Color="#FF9BDDFB" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="{x:Static SystemColors.ControlBrushKey}" EndPoint="0,1" StartPoint="0,0">
                        <GradientStop Color="#FFEEEDED" Offset="0"/>
                        <GradientStop Color="#FFDDDDDD" Offset="1"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="Black" />
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="{x:Type TreeViewItem}">
                        <Setter Property="IsSelected" Value="{Binding Selected, Mode=TwoWay}" />
                        <Setter Property="BorderThickness" Value="1.5"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="#adc6e5"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsSelectionActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="LightGray"/>
                            </MultiTrigger>
                        </Style.Triggers>
                        <Style.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="2"/>
                            </Style>
                        </Style.Resources>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="local:CommonClass" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding ImagePath}" Width="16" Height="16" Margin="2" />
                            <TextBlock Text="{Binding Name}" Margin="5,2,2,2" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Converter={StaticResource runStatusVisibility}, Path=RunStatus}">
                                <TextBlock Text="[" Margin="2,2,-1,2" />
                                <TextBlock Text="Running" Foreground="Blue" Margin="2,2,2,2" Visibility="{Binding Converter={StaticResource runStatusRunningVisibility}, Path=RunStatus}" />
                                <TextBlock Text="Success" Foreground="Green" Margin="2,2,2,2" Visibility="{Binding Converter={StaticResource runStatusSuccessVisibility}, Path=RunStatus}" />
                                <TextBlock Text="Failed" Foreground="Red" Margin="2,2,2,2" Visibility="{Binding Converter={StaticResource runStatusFailedVisibility}, Path=RunStatus}" />
                                <TextBlock Text="{Binding GetRowsAffected}" Margin="2,2,2,2" Visibility="{Binding Converter={StaticResource runStatusFailedVisibility}, Path=GetRowsAffected}" />
                                <TextBlock Text="]" Margin="-1,2,2,2" />
                            </StackPanel>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <StackPanel Grid.Row="0" Grid.Column="1" Name="stkMain" Margin="10,0,0,0">
                <Button Name="btnOpenFolder" Content="Open Folder..." Click="btnOpenFolder_Click" Margin="0,0,0,5" />
                <ComboBox Name="cmbFilter" Margin="0,5" SelectionChanged="cmbFilter_SelectionChanged" />
                <Separator />
                <StackPanel Name="stkOperation" IsEnabled="False" d:DataContext="{d:DesignInstance Type=local:SQLServer}">
                    <Button Name="btnEdit" Content="Edit..." Margin="0,5" Click="btnEdit_Click" />
                    <Separator />
                    <ComboBox Name="cmbServer" Margin="0,5" Text="{Binding Server}" />
                    <CheckBox Name="chkRunNext" Content="Run next file" Margin="0,5" />
                    <Button Name="btnRun" Content="Run" Margin="0,5" Click="btnRun_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
